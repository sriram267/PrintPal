{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@printpal/ui/greeting-engine": ["../../packages/ui/src/pal/greetingEngine.ts"],
      "@printpal/ui/pal.css": ["../../packages/ui/src/pal/palMascot.css"],
      "@printpal/ui": ["../../packages/ui/src/index.ts"],
      "@/components/*": ["src/components/*"],
      "@ui/*": ["src/components/ui/*"],
      "@ui-library/*": ["src/*"],
      "@/*": ["src/*"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src"],
  "exclude": []
}

